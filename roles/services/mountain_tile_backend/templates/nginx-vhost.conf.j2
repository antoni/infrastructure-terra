# Managed by Ansible: mountain_tile_backend
{% if mountain_tile_backend_public_scheme == 'https' %}
server {
    listen 80;
    server_name {{ mountain_tile_backend_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ mountain_tile_backend_domain }};

{% if mountain_tile_backend_certificate_mode == 'letsencrypt' %}
    ssl_certificate /etc/letsencrypt/live/{{ mountain_tile_backend_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ mountain_tile_backend_domain }}/privkey.pem;
{% elif mountain_tile_backend_certificate_mode == 'tailscale' %}
    ssl_certificate /var/lib/tailscale/certs/{{ mountain_tile_backend_domain }}.crt;
    ssl_certificate_key /var/lib/tailscale/certs/{{ mountain_tile_backend_domain }}.key;
{% elif mountain_tile_backend_certificate_mode == 'manual' %}
    ssl_certificate {{ mountain_tile_backend_manual_certificate }};
    ssl_certificate_key {{ mountain_tile_backend_manual_certificate_key }};
{% endif %}

{% for include_file in mountain_tile_backend_host_nginx_includes %}
    include {{ include_file }};
{% endfor %}

{% for cidr in mountain_tile_backend_host_allow_cidrs %}
    allow {{ cidr }};
{% endfor %}
{% if mountain_tile_backend_host_allow_cidrs | length > 0 %}
    deny all;
{% endif %}

    location / {
        proxy_pass http://127.0.0.1:{{ mountain_tile_backend_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
{% else %}
server {
    listen 80;
    server_name {{ mountain_tile_backend_domain }};

{% for include_file in mountain_tile_backend_host_nginx_includes %}
    include {{ include_file }};
{% endfor %}

{% for cidr in mountain_tile_backend_host_allow_cidrs %}
    allow {{ cidr }};
{% endfor %}
{% if mountain_tile_backend_host_allow_cidrs | length > 0 %}
    deny all;
{% endif %}

    location / {
        proxy_pass http://127.0.0.1:{{ mountain_tile_backend_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }
}
{% endif %}
