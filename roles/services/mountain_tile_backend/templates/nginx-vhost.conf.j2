# {{ ansible_managed }}
# Vhost of mountain_tile_backend on the shared reverse proxy (yourorg.shared_roles.reverse_proxy).
# TLS policy, security headers, real-IP handling and the rate-limit zones come from that role's snippets;
# this file only routes to the origin on loopback.

upstream mountain_tile_backend {
    server {{ mountain_tile_backend_bind_address }}:{{ mountain_tile_backend_host_port }};
    {% if mountain_tile_backend_upstream_keepalive | int > 0 %}
    keepalive {{ mountain_tile_backend_upstream_keepalive }};
{% endif %}
}

{% if mountain_tile_backend_public_scheme == 'https' %}
server {
    listen 80;
{% if mountain_tile_backend_listen_ipv6 | bool %}
    listen [::]:80;
{% endif %}
    server_name {{ mountain_tile_backend_domain }};

    # Certbot's nginx authenticator answers HTTP-01 challenges from this server block on renewal.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
{% if mountain_tile_backend_nginx_http2_directive | bool %}
    listen 443 ssl;
{% if mountain_tile_backend_listen_ipv6 | bool %}
    listen [::]:443 ssl;
{% endif %}
    http2 on;
{% else %}
    listen 443 ssl http2;
{% if mountain_tile_backend_listen_ipv6 | bool %}
    listen [::]:443 ssl http2;
{% endif %}
{% endif %}
    server_name {{ mountain_tile_backend_domain }};

    ssl_certificate     {{ mountain_tile_backend_tls_certificate }};
    ssl_certificate_key {{ mountain_tile_backend_tls_certificate_key }};
{% else %}
server {
    listen 80;
{% if mountain_tile_backend_listen_ipv6 | bool %}
    listen [::]:80;
{% endif %}
    server_name {{ mountain_tile_backend_domain }};
{% endif %}

{% if mountain_tile_backend_public_scheme == 'https' %}
    include {{ mountain_tile_backend_nginx_snippets_dir }}/ssl.conf;
{% endif %}
    include {{ mountain_tile_backend_nginx_snippets_dir }}/security-headers.conf;
{% if mountain_tile_backend_geoblocking_enforce | bool %}
    include {{ mountain_tile_backend_nginx_snippets_dir }}/geoblocking-enforce.conf;
{% endif %}
{% for cidr in mountain_tile_backend_allow_cidrs %}
    allow {{ cidr }};
{% endfor %}
{% if mountain_tile_backend_allow_cidrs | length > 0 %}
    deny all;
{% endif %}

{% if mountain_tile_backend_rate_limit_enabled | bool %}
    limit_req  zone=perip burst={{ mountain_tile_backend_rate_limit_burst }} nodelay;
    limit_conn addr {{ mountain_tile_backend_rate_limit_connections }};

{% endif %}
    # Liveness for monitoring: no rate limit, no logging noise.
    location = /healthz {
        access_log off;
        include {{ mountain_tile_backend_proxy_snippet }};
        proxy_pass http://mountain_tile_backend;
    }

    # Whole release archives (hundreds of MB to GB) and byte-range reads of them: stream, never buffer
    # to disk, and let the client's Range header through.
    location ^~ /pmtiles/ {
        include {{ mountain_tile_backend_proxy_snippet }};
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mountain_tile_backend;
    }

    location ^~ /releases/ {
        include {{ mountain_tile_backend_proxy_snippet }};
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_pass http://mountain_tile_backend;
    }

    # Everything else: tiles, TileJSON, styles, capabilities. Small responses; the container sets the
    # caching headers (immutable for versioned URLs).
    location / {
        include {{ mountain_tile_backend_proxy_snippet }};
        proxy_pass http://mountain_tile_backend;
    }
}
