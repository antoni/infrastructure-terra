server {
    listen 80;
    server_name _;

    root /srv/releases/current;
    etag on;
    if_modified_since exact;

    # Docker embedded DNS. Using a variable makes Nginx re-resolve the PMTiles
    # service instead of pinning a container IP at startup.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $pmtiles_upstream "pmtiles:8080";

    location = /healthz {
        access_log off;
        add_header Cache-Control "no-store" always;
        return 204;
    }

    location = / {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "mountain_tile_backend\n";
    }

    # The app hardcodes this one discovery URL. Initially it is a static file
    # from the active immutable release; the Go API can own it later.
    location = /api/capabilities {
        alias /srv/releases/current/capabilities.json;
        default_type application/json;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    # Mutable convenience aliases into current. Capabilities should normally
    # point clients at the immutable /releases/<release>/ URLs below.
    location = /capabilities.json {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    location = /manifest.json {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    location ^~ /styles/ {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    location ^~ /tilejson/ {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    location ^~ /metadata/ {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    location ^~ /glyphs/ {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    location ^~ /sprites/ {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    # Raw PMTiles remain available from the active release for tooling/offline
    # work. They are not the normal online rendering path.
    location ^~ /pmtiles/ {
        try_files $uri =404;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "ETag,Accept-Ranges,Content-Length,Content-Range" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_current_cache_seconds }}" always;
    }

    # Never treat /releases/current as immutable: current is a moving symlink.
    location ^~ /releases/current/ {
        return 404;
    }

    # Explicit release IDs are immutable. This serves styles, TileJSON,
    # metadata, sprites/glyphs, raw PMTiles and other release artifacts without
    # teaching Nginx individual dataset names.
    location ^~ /releases/ {
        alias /srv/releases/;
        autoindex off;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Expose-Headers "ETag,Accept-Ranges,Content-Length,Content-Range" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_immutable_cache_seconds }}, immutable" always;
    }

    # Public vector-tile compatibility: PMTiles uses the .mvt extension for MVT.
    # Existing clients may use .pbf, so translate it without changing the URL.
    location ~ ^/tiles/([A-Za-z0-9._-]+)/([A-Za-z0-9._@+-]+)/([0-9]+)/([0-9]+)/([0-9]+)\.pbf$ {
        rewrite ^/tiles/([^/]+)/([^/]+)/([0-9]+)/([0-9]+)/([0-9]+)\.pbf$ /__pmtiles/$1/pmtiles/$2/$3/$4/$5.mvt last;
    }

    # Versioned Z/X/Y route. The first segment is the immutable release ID and
    # the second is the PMTiles archive stem.
    location ~ ^/tiles/([A-Za-z0-9._-]+)/([A-Za-z0-9._@+-]+)/([0-9]+)/([0-9]+)/([0-9]+)\.(mvt|mlt|png|jpg|webp|avif)$ {
        rewrite ^/tiles/([^/]+)/([^/]+)/([0-9]+)/([0-9]+)/([0-9]+)\.([a-z0-9]+)$ /__pmtiles/$1/pmtiles/$2/$3/$4/$5.$6 last;
    }

    # Internal proxy target. pmtiles serve sees paths such as
    # /2026.10.0/pmtiles/<dataset>/12/2201/1375.webp and resolves the archive
    # /data/2026.10.0/pmtiles/<dataset>.pmtiles.
    location ^~ /__pmtiles/ {
        internal;

        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET,HEAD,OPTIONS" always;
            add_header Access-Control-Allow-Headers "Range,If-None-Match,If-Match" always;
            add_header Access-Control-Max-Age "3600" always;
            return 204;
        }

        rewrite ^/__pmtiles/(.*)$ /$1 break;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_pass http://$pmtiles_upstream;

        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age={{ mountain_tile_backend_immutable_cache_seconds }}, immutable" always;
    }

    location / {
        return 404;
    }
}
