---
# Managed by Ansible: mountain_tile_backend
x-logging: &logging
  driver: local
  options:
    max-size: "${LOG_MAX_SIZE}"
    max-file: "${LOG_MAX_FILE}"

services:
  nginx:
    image: "${NGINX_IMAGE}"
    restart: unless-stopped
    init: true
    depends_on:
      pmtiles:
        condition: service_started
    ports:
      - "${BIND_ADDRESS}:${HOST_PORT}:80"
    read_only: true
    tmpfs:
      - /var/cache/nginx
      - /run
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - NET_BIND_SERVICE
      - SETGID
      - SETUID
    mem_limit: "${NGINX_MEMORY_LIMIT}"
    pids_limit: ${PIDS_LIMIT}
    logging: *logging
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - "{{ mountain_tile_backend_release_root }}:/srv/releases:ro"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1/healthz || exit 1"]
      interval: 15s
      timeout: 3s
      retries: 3
      start_period: 5s

  pmtiles:
    image: "${PMTILES_IMAGE}"
    restart: unless-stopped
    init: true
    command:
      - serve
      - /data
      - --port=8080
      - --cache-size=${PMTILES_CACHE_SIZE_MB}
    expose:
      - "8080"
    # Nobody needs to be root to read a read-only tile store.
    user: "65534:65534"
    read_only: true
    tmpfs:
      - /tmp
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: "${PMTILES_MEMORY_LIMIT}"
    pids_limit: ${PIDS_LIMIT}
    logging: *logging
    volumes:
      - "{{ mountain_tile_backend_tile_store }}:/data:ro"
