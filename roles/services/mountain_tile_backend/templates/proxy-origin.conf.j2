# {{ ansible_managed }}
# Forwarding settings for the tile origin. Same as the shared proxy.conf except for the WebSocket
# `Connection: $connection_upgrade` line: that map yields `close` for ordinary requests, which makes nginx
# close the upstream connection after every request and defeats the `keepalive` of the upstream block
# (an empty proxy_set_header cannot override it within the same location). A tile origin has no WebSockets.
proxy_http_version 1.1;
proxy_set_header Connection        "";
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;
proxy_set_header X-Powered-By "";
proxy_redirect off;
